PORT=5000

# --- Veritabanı (MySQL / MariaDB) ---
# Sunucudaki uygulama veritabanına 127.0.0.1 üzerinden bağlanır.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password_here

# Tek adresle de verilebilir (tanımlıysa yukarıdakilerin yerine kullanılır):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB

# --- Auth ---
# JWT_SECRET mutlaka tanımlı ve uzun, rastgele bir değer olmalı.
JWT_SECRET=your_jwt_secret_key_change_in_production
SYSTEM_PASSWORD_HASH=your_system_password_hash_here

# --- Fotoğraf deposu (Cloudflare R2) ---
# Dördü de tanımlı değilse fotoğraf yükleme kapalıdır. Ayrıntı: docs/r2-photo-migration.md
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# --- Ortam / CORS ---
NODE_ENV=development
# CORS allowed origin (opsiyonel)
# FRONTEND_URL=http://localhost:5173

# Sistem şifresi hash'ini oluşturmak için:
# cd backend
# npx ts-node src/scripts/admin/generateSystemPasswordHash.ts
